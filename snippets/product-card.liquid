<article class="product-card"><a href="{{ product.url }}" class="product-card-media">{% if product.featured_media %}{{ product.featured_media | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw', loading: 'lazy', alt: product.featured_media.alt | default: product.title }}{% else %}<div class="product-empty-image"></div>{% endif %}</a><div class="product-card-info"><a href="{{ product.url }}">{{ product.title | escape }}</a><span>{{ product.price | money }}</span></div></article>
