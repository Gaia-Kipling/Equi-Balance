<section class="page-shell section-pad cart-page"><header class="page-heading"><p class="eyebrow">Equi Balance</p><h1>{{ 'general.cart.title' | t }}</h1></header>{% if cart.item_count == 0 %}<p class="empty-note">{{ 'general.cart.empty' | t }}</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Explore the shop <span>↗</span></a>{% else %}<form action="{{ routes.cart_url }}" method="post" novalidate><div class="cart-lines">{% for item in cart.items %}<article class="cart-line">{% if item.image %}{{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}<div class="cart-line-info"><a href="{{ item.url }}">{{ item.product.title | escape }}</a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}<span>{{ item.final_price | money }}</span><label for="CartQty-{{ forloop.index }}">Quantity</label><input id="CartQty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><a class="remove-link" href="{{ item.url_to_remove }}">Remove</a></div><strong>{{ item.final_line_price | money }}</strong></article>{% endfor %}</div><div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p>Shipping and taxes calculated at checkout.</p><button class="button button-light" type="submit" name="update">Update bag</button><button class="button button-gold" type="submit" name="checkout">Continue to checkout <span>↗</span></button></div></form>{% endif %}</section>
{% schema %}{"name":"Cart","settings":[],"presets":[{"name":"Cart"}]}{% endschema %}
