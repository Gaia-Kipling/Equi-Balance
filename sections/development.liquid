<section class="development section-pad"><div class="development-media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 900px) 58vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}{% else %}<div class="development-placeholder"><span>In development</span><i aria-hidden="true">EB</i></div>{% endif %}<span class="development-tag">{{ section.settings.tag | escape }}</span></div><div class="development-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="gold-rule"><span></span></div><div class="rte">{{ section.settings.text }}</div><p class="development-note">{{ section.settings.note | escape }}</p></div></section>
{% schema %}{"name":"In development","settings":[{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"text","id":"tag","label":"Image label","default":"The first chapter"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A first, thoughtful step"},{"type":"text","id":"heading","label":"Heading","default":"Balance pads, in the making."},{"type":"richtext","id":"text","label":"Text","default":"<p>Our first product is an equine balance pad, currently in development. We are taking the time to explore how thoughtful equipment can support the everyday partnership between horse and rider.</p>"},{"type":"text","id":"note","label":"Status note","default":"Still in development · Not yet available"}],"presets":[{"name":"Balance pad development"}]}{% endschema %}
