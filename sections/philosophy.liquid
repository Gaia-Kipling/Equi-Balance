<section class="philosophy section-pad"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="philosophy-bottom"><p>{{ section.settings.body | escape }}</p><span class="philosophy-mark" aria-hidden="true">✳</span></div>{% if section.settings.link_label != blank %}<a class="text-link" href="{{ section.settings.link | default: '/pages/our-story' }}">{{ section.settings.link_label | escape }} <span>↗</span></a>{% endif %}</section>
{% schema %}{"name":"Brand philosophy","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"What we believe"},{"type":"text","id":"heading","label":"Statement","default":"Good equipment should feel considered. Good care should feel within reach."},{"type":"textarea","id":"body","label":"Supporting text","default":"We are building Equi Balance around thoughtful choices, honest development, and a belief that helping your horse should not have to cost a fortune."},{"type":"text","id":"link_label","label":"Link label","default":"A little more about us"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Brand philosophy"}]}{% endschema %}
