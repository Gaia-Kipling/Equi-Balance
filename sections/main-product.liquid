<section class="product-page section-pad"><div class="product-gallery">{% if product.media.size > 0 %}{% for media in product.media %}<div class="product-media">{% if media.media_type == 'image' %}{{ media | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy', alt: product.title }}{% else %}{{ media | media_tag }}{% endif %}</div>{% endfor %}{% else %}<div class="product-empty-image"></div>{% endif %}</div><div class="product-details"><p class="eyebrow">Equi Balance · Considered equipment</p><h1>{{ product.title | escape }}</h1><p class="product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</p>{% if product.description != blank %}<div class="rte">{{ product.description }}</div>{% endif %}{% form 'product', product, class: 'product-form', data-product-form: '' %}{% if product.has_only_default_variant == false %}<label for="Variant-{{ section.id }}">Options</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label><input id="Quantity-{{ section.id }}" name="quantity" type="number" min="1" value="1"><button class="button button-dark" type="submit" name="add" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button><p class="form-feedback" role="status" aria-live="polite"></p>{{ form | payment_button }}{% endform %}</div></section>{% if product %}<script type="application/ld+json">{{ product | structured_data }}</script>{% endif %}
{% schema %}{"name":"Product","settings":[],"presets":[{"name":"Product"}]}{% endschema %}
