<section class="newsletter">
  <div class="container newsletter-inner">
    <div>
      <p class="eyebrow">Equi Balance journal</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="Your email address" required aria-label="Email address">
      <button class="button button--gold" type="submit">Subscribe</button>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay connected" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Be the first to hear about Equi Balance products, launches and updates." }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}