<header class="site-header" data-site-header>
  <div class="container header-inner" style="--eb-logo-width: {{ section.settings.logo_width }}px;">
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="SiteNav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav class="header-nav" id="SiteNav" data-mobile-nav>
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="/pages/our-story">Our Story</a>
      <a href="/pages/why-equi-balance">Why Equi Balance</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact</a>
    </nav>
    <a class="header-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 800 | image_tag: widths: '220,320,480,640,800', loading: 'eager', alt: shop.name, class: 'header-logo__image' }}
      {% else %}
        <img class="header-logo__image" src="{{ 'equi-balance-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="600" height="600" loading="eager">
      {% endif %}
    </a>
    <div class="header-actions">
      <a class="icon-link search-link" href="{{ routes.search_url }}">Search</a>
      <a class="icon-link" href="{{ routes.cart_url }}">Bag <span class="cart-count">{{ cart.item_count }}</span></a>
    </div>
  </div>
</header>
{% schema %}
{
  "name":"Header",
  "settings":[
    {"type":"image_picker","id":"logo","label":"Horizontal header logo","info":"Use the Equi Balance horizontal logo for the storefront header."},
    {"type":"range","id":"logo_width","label":"Logo width","min":140,"max":360,"step":10,"unit":"px","default":240}
  ]
}
{% endschema %}