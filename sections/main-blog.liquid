<section class="page-shell section-pad"><header class="page-heading"><p class="eyebrow">Equi Balance · Knowledge Hub</p><h1>{{ blog.title | escape }}</h1>{% if blog.articles_count == 0 %}<p class="empty-note">New perspectives are being prepared. Please check back soon.</p>{% endif %}</header>{% paginate blog.articles by 9 %}<div class="article-grid">{% for article in blog.articles %}<article class="article-card"><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy', alt: article.title }}{% else %}<div class="article-placeholder"></div>{% endif %}<p class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</p><h2>{{ article.title | escape }}</h2><p>{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p></a></article>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}</nav>{% endif %}{% endpaginate %}</section>
{% schema %}{"name":"Blog","settings":[],"presets":[{"name":"Blog"}]}{% endschema %}
