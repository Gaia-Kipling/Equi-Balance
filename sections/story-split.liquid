<section class="split">
  <div class="split__media">
    <div style="position:relative;z-index:2;text-align:center;color:var(--eb-cream);padding:30px">
      <p class="eyebrow">Equi Balance</p>
      <div style="font-family:Cinzel,Georgia,serif;font-size:clamp(38px,5vw,72px);line-height:1.08">Movement.<br>Strength.<br>Balance.</div>
      <div class="gold-rule"></div>
      <p style="color:rgba(245,240,230,.7);font-size:12px;letter-spacing:.12em;text-transform:uppercase">Together.</p>
    </div>
  </div>
  <div class="split__content">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {% if section.settings.button_label != blank %}<div class="buttons"><a class="button button--outline" href="{{ section.settings.button_link | default: '/pages/our-story' }}">{{ section.settings.button_label }}</a></div>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Story split",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our philosophy"},
    {"type":"text","id":"heading","label":"Heading","default":"Equine products with a purpose."},
    {"type":"textarea","id":"text","label":"Text","default":"We believe equestrian products should be thoughtfully designed, practical and purposeful — with the horse at the centre of every decision."},
    {"type":"text","id":"button_label","label":"Button","default":"Discover our approach"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "presets":[{"name":"Story split"}]
}
{% endschema %}