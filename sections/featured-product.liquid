{% assign featured = section.settings.product %}
<section class="section">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">The first Equi Balance product</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="gold-rule"></div>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="product-feature">
      <div class="product-art">
        {% if featured != blank and featured.featured_image %}
          {{ featured.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: featured.title }}
        {% else %}
          <div class="pad-visual" role="img" aria-label="Equi Balance Balance Pad concept"></div>
        {% endif %}
      </div>
      <div class="product-feature__copy">
        <span class="coming-badge">Coming soon</span>
        <h2>{{ section.settings.product_name }}</h2>
        <p>{{ section.settings.description }}</p>
        <div class="product-meta">
          <div><strong>Format</strong><span>Pair of 2 pads</span></div>
          <div><strong>Prototype size</strong><span>30 × 25 cm</span></div>
          <div><strong>Core concept</strong><span>Closed-cell EVA</span></div>
          <div><strong>Base</strong><span>Flexible textured rubber</span></div>
        </div>
        <p class="form-note">These are current working prototype decisions. Final material specifications, load guidance, finished weight and pricing will be confirmed after testing.</p>
        <div class="buttons"><a class="button button--dark" href="{{ section.settings.button_link | default: '/pages/coming-soon' }}">{{ section.settings.button_label }}</a></div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Featured product",
  "settings":[
    {"type":"product","id":"product","label":"Optional product"},
    {"type":"text","id":"heading","label":"Section heading","default":"The first Equi Balance product"},
    {"type":"text","id":"product_name","label":"Product name","default":"Balance Pad Pair"},
    {"type":"textarea","id":"text","label":"Section text","default":"Our first product is being developed carefully, with testing before commercial launch."},
    {"type":"textarea","id":"description","label":"Product description","default":"A purposefully designed equine balance and proprioception pad, currently being refined through material, durability and use testing."},
    {"type":"text","id":"button_label","label":"Button","default":"See what's coming"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "presets":[{"name":"Featured product"}]
}
{% endschema %}