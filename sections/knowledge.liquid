{% assign blog = section.settings.blog %}{% if blog != blank %}<section class="knowledge section-pad"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ blog.url }}">Visit the Knowledge Hub <span>↗</span></a></div>{% if blog.articles_count > 0 %}<div class="article-grid">{% for article in blog.articles limit: 3 %}<article class="article-card"><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | default: article.title }}{% else %}<div class="article-placeholder"></div>{% endif %}<p class="eyebrow">{{ article.published_at | date: '%B %Y' }}</p><h3>{{ article.title | escape }}</h3><p>{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p></a></article>{% endfor %}</div>{% else %}<p class="empty-note">New perspectives are being prepared. Please check back soon.</p>{% endif %}</section>{% endif %}
{% schema %}{"name":"Knowledge Hub","settings":[{"type":"blog","id":"blog","label":"Blog"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"From the Knowledge Hub"},{"type":"text","id":"heading","label":"Heading","default":"A little more understanding"}],"presets":[{"name":"Knowledge Hub"}]}{% endschema %}
