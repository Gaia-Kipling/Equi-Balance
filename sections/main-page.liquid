<div class="page-header">
  <div class="container">
    <div class="breadcrumbs">
      <a href="{{ routes.root_url }}">{{ shop.name }}</a>
      {% if page.title %} / {{ page.title }}{% endif %}
    </div>

    <h1>{{ page.title }}</h1>
  </div>
</div>

<div class="container">
  <div class="rte">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page content",
  "settings": []
}
{% endschema %}