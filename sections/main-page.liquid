<section class="page-header">
  <div class="container">
    <p class="eyebrow">Equi Balance</p>
    <div class="breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      {% if page.title %} / {{ page.title }}{% endif %}
    </div>
    <h1>{{ page.title }}</h1>
    <div class="gold-rule"></div>
  </div>
</section>
<section class="section page-content-section">
  <div class="container">
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Page content",
  "settings": []
}
{% endschema %}