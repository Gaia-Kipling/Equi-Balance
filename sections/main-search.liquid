<section class="page-shell section-pad"><header class="page-heading"><p class="eyebrow">Equi Balance</p><h1>Search</h1></header><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label class="visually-hidden" for="SearchInput">Search</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, stories and more"><button class="button button-dark" type="submit">Search</button></form>{% if search.performed %}<p class="search-summary">{{ search.results_count }} result{% unless search.results_count == 1 %}s{% endunless %} for “{{ search.terms | escape }}”</p>{% if search.results_count > 0 %}<div class="search-results">{% for item in search.results %}<article class="search-result"><a href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 480 | image_tag: width: 180, loading: 'lazy', alt: item.featured_image.alt | default: item.title }}{% endif %}<div><p class="eyebrow">{{ item.object_type | capitalize }}</p><h2>{{ item.title | escape }}</h2>{% if item.price %}<span>{{ item.price | money }}</span>{% else %}<p>{{ item.content | strip_html | truncate: 130 }}</p>{% endif %}</div></a></article>{% endfor %}</div>{% else %}<p class="empty-note">No results found. Try another search.</p>{% endif %}{% endif %}</section>
{% schema %}{"name":"Search","settings":[],"presets":[{"name":"Search"}]}{% endschema %}
