<section class="editorial section-pad {% if section.settings.reverse %}editorial-reverse{% endif %}" style="--section-bg:{{ section.settings.background }}">
  <div class="editorial-media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 900px) 48vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}{% else %}<div class="editorial-placeholder"><span>{{ section.settings.image_note | escape }}</span></div>{% endif %}<span class="image-caption">{{ section.settings.caption | escape }}</span></div>
  <div class="editorial-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="text-link" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} <span>↗</span></a>{% endif %}</div>
</section>
{% schema %}{"name":"Editorial image & text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_note","label":"Image placeholder note","default":"A place for considered moments in the stable"},{"type":"text","id":"caption","label":"Image caption"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A quieter kind of ambition"},{"type":"text","id":"heading","label":"Heading","default":"Thoughtful by nature. Accessible by design."},{"type":"richtext","id":"text","label":"Text","default":"<p>We believe helping your horse should not have to cost a fortune. Equi Balance is a considered approach to equestrian equipment: thoughtful in its purpose, approachable in its spirit, and made with the partnership between horse and rider at heart.</p>"},{"type":"text","id":"button_label","label":"Link label"},{"type":"url","id":"button_link","label":"Link"},{"type":"checkbox","id":"reverse","label":"Place image on right","default":false},{"type":"color","id":"background","label":"Background","default":"#F5F2E9"}],"presets":[{"name":"Editorial image & text"}]}{% endschema %}
