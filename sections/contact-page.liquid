<section class="page-shell section-pad"><header class="page-heading"><p class="eyebrow">We'd love to hear from you</p><h1>{{ section.settings.heading | default: page.title | escape }}</h1></header><div class="contact-layout"><div class="page-content rte">{{ page.content }}</div>{% form 'contact', class: 'contact-form' %}{% if form.posted_successfully? %}<p class="form-success">Thank you for getting in touch. Your message has been sent.</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName-{{ section.id }}">Name</label><input id="ContactName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required><label for="ContactEmail-{{ section.id }}">Email</label><input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required><label for="ContactPhone-{{ section.id }}">Phone (optional)</label><input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel"><label for="ContactMessage-{{ section.id }}">Message</label><textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="6" required>{{ form.body }}</textarea><button class="button button-dark" type="submit">Send message <span>↗</span></button>{% endform %}</div></section>
{% schema %}{"name":"Contact page","settings":[{"type":"text","id":"heading","label":"Heading"}],"presets":[{"name":"Contact page"}]}{% endschema %}
