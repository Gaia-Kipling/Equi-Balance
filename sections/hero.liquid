<section class="hero">
  <div class="container hero-content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="buttons">
      {% if section.settings.button_label != blank %}
        <a class="button button--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a class="button button--light" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Equi Balance hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Equine products, purposefully designed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Supporting better movement." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Thoughtfully designed products for equine movement, stability and performance." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Our approach" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Equi Balance hero" }]
}
{% endschema %}