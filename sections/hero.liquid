<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="buttons">
        {% if section.settings.button_label != blank %}<a class="button button--gold" href="{{ section.settings.button_link | default: '/pages/coming-soon' }}">{{ section.settings.button_label }}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="button button--outline" href="{{ section.settings.secondary_link | default: '/pages/our-story' }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
    </div>
    <div class="hero__visual">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '360,520,720,1000', loading: 'eager', alt: section.settings.image_alt, class: 'hero__image' }}
      {% else %}
        <div class="hero-mark" role="img" aria-label="Equi Balance brand mark">Equi<br>Balance</div>
      {% endif %}
      <div class="hero__stamp">Thoughtful<br>products<br>for horses</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Equi Balance hero",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Equestrian products, purposefully designed"},
    {"type":"text","id":"heading","label":"Heading","default":"Supporting better movement."},
    {"type":"textarea","id":"text","label":"Text","default":"Thoughtfully developed products for horses, with movement, stability and purposeful design at the centre."},
    {"type":"image_picker","id":"image","label":"Hero image","info":"Use a clean product or equestrian brand image. Leave blank to use the text mark."},
    {"type":"text","id":"image_alt","label":"Hero image alt text","default":"Equi Balance equestrian products"},
    {"type":"text","id":"button_label","label":"Primary button","default":"Discover Equi Balance"},
    {"type":"url","id":"button_link","label":"Primary link"},
    {"type":"text","id":"secondary_label","label":"Secondary button","default":"Our story"},
    {"type":"url","id":"secondary_link","label":"Secondary link"}
  ],
  "presets":[{"name":"Equi Balance hero"}]
}
{% endschema %}