<section class="hero" style="--hero-shade:{{ section.settings.overlay | divided_by: 100.0 }};--hero-focus:{{ section.settings.image.presentation.focal_point | default: '50% 50%' }};--hero-height:{{ section.settings.height }}vh">
  {% if section.settings.image %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1600, 2000, 2400', sizes: '100vw', class: 'hero-image', preload: true, alt: section.settings.image.alt }}{% else %}<div class="hero-placeholder" aria-hidden="true"><span>Equi Balance · South Africa</span></div>{% endif %}
  <div class="hero-content hero-{{ section.settings.alignment }}"><p class="eyebrow">Equi Balance · Supporting better movement</p><h1>{{ section.settings.heading | escape }}</h1><p class="hero-copy">{{ section.settings.subheading | escape }}</p>{% if section.settings.button_label != blank %}<a class="button button-light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</div><div class="hero-index">01 <span></span> A considered beginning</div>
</section>
{% schema %}{"name":"Cinematic hero","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"select","id":"alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},{"type":"text","id":"heading","label":"Heading","default":"A considered approach to equestrian equipment."},{"type":"textarea","id":"subheading","label":"Supporting text","default":"Thoughtfully developed for the partnership between horse and rider."},{"type":"text","id":"button_label","label":"Button label","default":"Discover Equi Balance"},{"type":"url","id":"button_link","label":"Button link"},{"type":"range","id":"overlay","min":0,"max":75,"step":5,"unit":"%","label":"Image overlay","default":30},{"type":"range","id":"height","min":55,"max":100,"step":5,"unit":"vh","label":"Hero height","default":85}],"presets":[{"name":"Cinematic hero"}]}{% endschema %}
