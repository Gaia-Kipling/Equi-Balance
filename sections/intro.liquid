<section class="section section--cream">
  <div class="container">
    <div class="brand-intro">
      <div>
        <p class="eyebrow">The Equi Balance approach</p>
        <div class="brand-intro__lead">Designed with purpose. Made for horses.</div>
        <div class="brand-signature">Supporting better movement</div>
      </div>
      <div class="brand-intro__copy">
        <p>{{ section.settings.text }}</p>
        <p>Equi Balance begins with a balance and proprioception pad, but the brand is intentionally being developed beyond a single product. The aim is to build a considered range of equestrian products that are useful, refined and genuinely purposeful.</p>
        <div class="buttons"><a class="button button--outline" href="{{ section.settings.button_link | default: '/pages/our-story' }}">{{ section.settings.button_label }}</a></div>
      </div>
    </div>
  </div>
</section>
<section class="section section--green" style="padding-top:55px;padding-bottom:55px">
  <div class="container">
    <div class="values">
      {% for block in section.blocks %}
        <article class="value" {{ block.shopify_attributes }}>
          <div class="value__number">0{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Brand introduction",
  "settings":[
    {"type":"textarea","id":"text","label":"Intro text","default":"Equi Balance is a developing South African equestrian product brand focused on thoughtful products for equine movement, stability, comfort and performance."},
    {"type":"text","id":"button_label","label":"Button","default":"Our story"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "blocks":[{"type":"value","name":"Brand value","settings":[{"type":"text","id":"title","label":"Title","default":"Movement"},{"type":"textarea","id":"text","label":"Text","default":"Purposeful design around equine movement."}]}],
  "presets":[{"name":"Brand introduction","blocks":[{"type":"value","settings":{"title":"Movement","text":"Purposeful design around equine movement."}},{"type":"value","settings":{"title":"Stability","text":"Thoughtful products developed with balance in mind."}},{"type":"value","settings":{"title":"Practicality","text":"Useful, considered products made for everyday equestrian life."}},{"type":"value","settings":{"title":"Progress","text":"A growing brand built through testing and refinement."}}] }]
}
{% endschema %}