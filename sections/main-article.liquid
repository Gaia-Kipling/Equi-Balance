<article class="article-page section-pad"><header class="article-header"><p class="eyebrow"><a href="{{ blog.url }}">Knowledge Hub</a> · {{ article.published_at | date: '%B %d, %Y' }}</p><h1>{{ article.title | escape }}</h1>{% if article.excerpt != blank %}<p class="article-deck">{{ article.excerpt | strip_html }}</p>{% endif %}</header>{% if article.image %}{{ article.image | image_url: width: 1800 | image_tag: widths: '700, 1100, 1500, 1800', sizes: '100vw', loading: 'eager', alt: article.title, class: 'article-hero-image' }}{% endif %}<div class="article-body rte">{{ article.content }}</div></article>
{% schema %}{"name":"Article","settings":[],"presets":[{"name":"Article"}]}{% endschema %}
