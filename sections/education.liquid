<section class="education section-pad"><div class="education-heading"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="education-copy"><div class="rte">{{ section.settings.text }}</div>{% if section.settings.link_label != blank %}<a class="text-link" href="{{ section.settings.link | default: '/blogs/knowledge-hub' }}">{{ section.settings.link_label | escape }} <span>↗</span></a>{% endif %}</div></section>
{% schema %}{"name":"Movement & learning","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Knowledge, shared thoughtfully"},{"type":"text","id":"heading","label":"Heading","default":"Better questions build better understanding."},{"type":"richtext","id":"text","label":"Text","default":"<p>Balance and proprioception are part of a wider conversation about how horses move and experience the world. Our Knowledge Hub is a place for considered learning and useful questions, shared with care as resources are developed.</p>"},{"type":"text","id":"link_label","label":"Link label","default":"Explore the Knowledge Hub"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Movement & learning"}]}{% endschema %}
