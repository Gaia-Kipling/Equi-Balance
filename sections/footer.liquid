<footer class="site-footer"><div class="footer-top"><div class="footer-brand">{% if settings.logo %}{{ settings.logo | image_url: width: 600 | image_tag: widths: '200, 400, 600', width: 220, alt: shop.name }}{% else %}{{ 'equi-balance-logo.png' | asset_url | image_tag: width: 600, widths: '200, 400, 600', width: 220, alt: shop.name }}{% endif %}<p>Supporting better movement.</p></div><nav aria-label="Footer navigation">{% assign menu = section.settings.menu %}{% if menu != blank %}{% for link in menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/our-story">Our Story</a><a href="/pages/contact">Contact</a><a href="/pages/faqs">FAQs</a>{% endif %}</nav><div class="footer-policies"><p>Thoughtful equipment. Better movement.</p>{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endif %}{% endfor %}</div></div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} Equi Balance · South Africa</span><span>{{ localization.country.name }}{% if localization.country.currency.iso_code %} · {{ localization.country.currency.iso_code }}{% endif %}</span></div></footer>
{% schema %}{"name":"Footer","settings":[{"type":"link_list","id":"menu","label":"Footer menu"}],"presets":[{"name":"Footer"}]}{% endschema %}
