<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {% if page_title %}{{ page_title }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}{% else %}{{ shop.name }}{% endif %}
    </title>
    {{ content_for_header }}
    {{ 'equi-balance.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'equi-balance.js' | asset_url }}" defer></script>
  </head>
  <body class="template-{{ template.name | handle }}">
    {% sections 'header-group' %}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <a class="skip-link" href="#MainContent">Skip to content</a>
  </body>
</html>